DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Use DATABASE_URL in production (Supabase PostgreSQL or another managed PostgreSQL).
DATABASE_URL=postgresql://postgres:password@localhost:5432/agave_basic
DB_SSL_REQUIRE=False

# Optional: image uploads in Supabase Storage through its S3-compatible API.
# Leave SUPABASE_S3_ENDPOINT empty to use local media/ during development.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=agave-products
SUPABASE_S3_REGION=us-east-1
# Example: project-ref.supabase.co/storage/v1/object/public/agave-products
SUPABASE_STORAGE_PUBLIC_DOMAIN=

# Mercado Pago Checkout Pro. Keep secrets only on the server.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUCCESS_URL=http://127.0.0.1:8000/pago/exito/
MERCADOPAGO_FAILURE_URL=http://127.0.0.1:8000/pago/error/
MERCADOPAGO_PENDING_URL=http://127.0.0.1:8000/pago/pendiente/

# Envia.com. URLs are configurable because sandbox and production differ.
ENVIA_API_TOKEN=
ENVIA_RATE_URL=https://api-test.envia.com/ship/rate/
ENVIA_SHIPMENT_URL=https://api-test.envia.com/ship/generate/

# Stock is held while the customer pays.
STOCK_HOLD_MINUTES=15

# Email (console backend is safe for local development).
DEFAULT_FROM_EMAIL=Agave Racquet Club <no-reply@example.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

